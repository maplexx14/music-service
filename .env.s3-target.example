# New S3 account. Copy to .env.s3-target.local (ignored by git).
S3_ENDPOINT=https://s3.buckets.ru/
S3_REGION=ru-1
S3_BUCKET=bol
S3_ACCESS_KEY=
S3_SECRET_KEY=
# If the old .env.prod has S3_SSE_C_KEY, copy its exact value here.
# A different 32-byte base64 key is also supported for re-encryption.
S3_SSE_C_KEY=
S3_SINGLE_PUT_MAX_MB=128
