# Шаблон прод-конфигурации. Скопируйте в .env.prod НА СЕРВЕРЕ и заполните.
#
#   cp .env.prod.example .env.prod
#
# .env.prod в git не попадает (см. .gitignore). Секреты генерируйте прямо на
# сервере — не переиспользуйте дев-значения: SECRET_KEY из .env.example лежит
# в публичном репозитории, с ним JWT подделывается кем угодно.
#
# Сгенерировать все три секрета разом:
#   for k in SECRET_KEY POSTGRES_PASSWORD MINIO_SECRET_KEY; do
#     echo "$k=$(openssl rand -hex 32)"
#   done

# ─────────────────────────── обязательное ───────────────────────────

# Домен сервиса. A-запись должна указывать на IP этого VDS ДО выпуска
# сертификата — Let's Encrypt проверяет владение через http://$DOMAIN/.
DOMAIN=music.example.com

# Почта для Let's Encrypt: туда придёт предупреждение, если автопродление
# сломается и сертификат начнёт истекать.
CERTBOT_EMAIL=admin@example.com

# Секрет подписи JWT. openssl rand -hex 32
# Смена значения инвалидирует все выданные токены (пользователи перелогинятся).
SECRET_KEY=

# PostgreSQL. Пароль — тоже openssl rand -hex 32.
POSTGRES_USER=music_user
POSTGRES_PASSWORD=
POSTGRES_DB=music_db

# MinIO. Ключи наружу не публикуются (S3-API живёт только в docker-сети),
# но консоль доступна через SSH-туннель — пароль всё равно должен быть стойким.
MINIO_ACCESS_KEY=music_minio
MINIO_SECRET_KEY=

# ─────────────────────── ресурсы (дефолты под 8 ГБ) ───────────────────────
# Менять только вместе: инвариант
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) × GUNICORN_WORKERS < POSTGRES_MAX_CONNECTIONS
# По умолчанию: (15 + 15) × 4 = 120 < 200. Нарушение инварианта проявляется
# как "too many connections" под нагрузкой, а не при старте.
GUNICORN_WORKERS=4
POSTGRES_MAX_CONNECTIONS=200
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
THREADPOOL_TOKENS=70

# Postgres: shared_buffers ~12.5% RAM, effective_cache_size ~50%.
# Для 16 ГБ: 2GB / 8GB. Для 4 ГБ: 512MB / 2GB.
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB

# Потолок памяти Redis. Хранит только данные с TTL (кэш, история потока,
# счётчики rate-limit) — при достижении лимита старое вытесняется.
REDIS_MAXMEMORY=512mb

# ─────────────────────────── хранилище ───────────────────────────

# minio — аудио и обложки в объектном хранилище (рекомендуется).
# local  — на диске контейнера; тогда следите за размером тома music_files.
STORAGE_BACKEND=minio
MINIO_BUCKET_MUSIC=music
MINIO_BUCKET_COVERS=covers

# Потолок кэша yt-dlp (МБ). Растёт при прослушивании внешних треков.
YTDLP_CACHE_MAX_MB=4096

# ─────────────────────────── фронтенд ───────────────────────────

# Оставьте ПУСТЫМ: фронтенд возьмёт API как <origin>/api, что верно, когда
# фронт и бэк за одним доменом (наш случай). Заполнять только если API живёт
# на отдельном домене.
VITE_API_URL=

# CORS. По умолчанию https://$DOMAIN. Явное значение нужно, только если
# фронтенд открывается с другого домена; несколько — через запятую.
# Внимание: "*" отключает allow_credentials (backend/app/main.py:27).
# CORS_ORIGINS=https://music.example.com

# ─────────────────────── внешние интеграции (опционально) ───────────────────────
# Все необязательны: без них соответствующий источник просто отключается.

# Spotify — импорт плейлистов (метаданные; аудио матчится в YouTube Music).
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# Yandex Music — OAuth-токен для обхода CAPTCHA.
# https://github.com/MarshalX/yandex-music/blob/main/docs/authentication.md
YANDEX_MUSIC_TOKEN=

# Jamendo (устаревший источник).
JAMENDO_CLIENT_ID=

# Invidious — ускоряет резолв YouTube-аудио вместо yt-dlp. При недоступности
# инстанса резолв прозрачно падает обратно на yt-dlp.
INVIDIOUS_ENABLED=0
INVIDIOUS_API_BASE=
INVIDIOUS_TIMEOUT=10

# ─────────────────────────── транскодинг ───────────────────────────
# Аудио жмётся в AAC: меньше размер, быстрее старт. Требует CPU при загрузке.
TRANSCODE_ENABLED=1
AAC_BITRATE=128
AAC_SAMPLE_RATE=44100
