# Скопируйте в .env и заполните

# Обязательный секрет для JWT (сгенерируйте: openssl rand -hex 32)
SECRET_KEY=

# PostgreSQL (по умолчанию — dev-значения)
POSTGRES_USER=music_user
POSTGRES_PASSWORD=music_password
POSTGRES_DB=music_db

# URL бэкенд API для фронтенда.
# Оставьте пустым при работе через nginx reverse proxy / ngrok — фронтенд
# сам возьмёт API как <origin>/api. Задавайте явный URL только если фронтенд
# и бэкенд открываются по разным адресам.
VITE_API_URL=

# Jamendo API client id (устаревший источник, заменён на Soulseek).
JAMENDO_CLIENT_ID=

# Soulseek (через демон slskd) — основной внешний источник треков.
# Укажите реальные учётные данные аккаунта Soulseek.
# Если SOULSEEK_USERNAME пуст, внешний поиск будет отключён.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
# API-ключ для защиты REST API slskd (сгенерируйте: openssl rand -hex 32).
# Одно и то же значение используется slskd и бэкендом.
SLSKD_API_KEY=
# URL REST API slskd (внутри docker-сети).
SLSKD_URL=http://slskd:5030

# ─── Yandex Music (нативная интеграция) ───
# OAuth-токен для доступа к API Yandex Music.
# Получить: https://github.com/MarshalX/yandex-music/blob/main/docs/authentication.md
# Без этого токена импорт из Yandex Music будет работать через yt-dlp (с CAPTCHA).
YANDEX_MUSIC_TOKEN=

# CORS: разрешённые origins для бэкенда (через запятую). * — только для разработки
CORS_ORIGINS=*

# ─── Хранилище файлов (MinIO / объектное хранилище) ───
# local  — музыка и обложки лежат на диске (тома music_files/cover_files);
# minio  — новые загрузки уходят в MinIO. Старые файлы на диске продолжают
#          работать в любом режиме (гибрид). Для переноса старых файлов в
#          MinIO выполните: docker compose exec backend python -m app.scripts.migrate_to_minio
STORAGE_BACKEND=minio

# Внутренний адрес MinIO внутри docker-сети (используется бэкендом для
# загрузки/удаления объектов). Менять обычно не нужно.
MINIO_ENDPOINT=minio:9000

# Адрес, по которому БРАУЗЕР забирает аудио (presigned URL) и обложки.
# Именно этим хостом подписываются ссылки, поэтому он должен быть доступен
# из браузера. Для доступа с других устройств/через туннель укажите внешний
# адрес, напр. https://minio.example.com или http://<ip-хоста>:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Ключи доступа MinIO (в проде замените на длинные случайные значения).
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# true, если MINIO_PUBLIC_ENDPOINT работает по https (без указания схемы в URL).
MINIO_SECURE=false

# Имена бакетов: music — приватный (аудио, presigned), covers — публичный.
MINIO_BUCKET_MUSIC=music
MINIO_BUCKET_COVERS=covers

# Быстрый резолв YouTube-аудио через self-hosted Invidious (+companion) вместо
# yt-dlp. Ускоряет старт воспроизведения на порядок; при недоступности/сбое
# инстанса резолв прозрачно падает обратно на yt-dlp. По умолчанию выключен.
INVIDIOUS_ENABLED=0
# Список инстансов через запятую, напр. http://localhost:3000
INVIDIOUS_API_BASE=
INVIDIOUS_TIMEOUT=10

# Публичный доступ через Tuna tunnel (сервис tuna в compose).
# Токен: создайте в https://my.tuna.am → Settings → API Tokens
TUNA_TOKEN=

# ─── AAC транскодинг ───
# Все аудиофайлы транскодируются в AAC для уменьшения размера и ускорения загрузки.
# Отключить: TRANSCODE_ENABLED=0
TRANSCODE_ENABLED=1
# Битрейт AAC в kbps (128 = прозрачное качество для большинства слушателей)
AAC_BITRATE=128
# Частота дискретизации (44100 = стандарт CD, 48000 = broadcast)
AAC_SAMPLE_RATE=44100
