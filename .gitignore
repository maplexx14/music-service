# Environment
.env
.env.local
.env.*.local
# Прод-секреты: генерируются на сервере (см. DEPLOY.md), в репозиторий не
# попадают. .env.prod.example — шаблон, он отслеживается.
.env.prod

# Прокси для invidious-companion: в списке пароли, в active.env — активный
# выход с кредами (его генерирует rotate.sh). Шаблон —
# invidious/proxy-pool/proxies.list.example, он отслеживается.
invidious/proxy-pool/proxies.list
invidious/proxy-pool/active.env
# Активный выход для скачивания googlevideo: тот же URL с кредами, читается
# бэкендом (STREAM_PROXY_FILE). Пишется rotate.sh.
invidious/proxy-pool/stream-proxy/active.url
# Активный выход для метаданных SoundCloud (SOUNDCLOUD_PROXY_FILE). Тоже с
# кредами и тоже из пула, но знак отдельный: SoundCloud заблокирован целиком, а
# платный выход для googlevideo-аудио включать из-за этого не нужно.
invidious/proxy-pool/stream-proxy/soundcloud.url

# Cookie-сессии YouTube против bot-check: Netscape-экспорт браузера
# (YTDLP_COOKIEFILE) и oauth-файл ytmusicapi (YTMUSIC_AUTH). Приезжают на
# сервер отдельно (см. DEPLOY-инструкцию в .env.example), в git не попадают.
backend/secrets/*
# Строка-заголовок Cookie для invidious-companion (YOUTUBE_SESSION_COOKIES):
# генерируется из backend/secrets/ytdlp_cookies.txt скриптом
# invidious/proxy-pool/make-companion-cookies.sh — там сессия Google, не в git.
invidious/companion-cookies.env

