# Bootstrap-конфиг: действует ТОЛЬКО пока не выпущен сертификат.
#
# Проблема курицы и яйца: ACME http-01 требует работающий nginx на порту 80,
# а nginx с ssl_certificate на несуществующий файл не стартует вообще.
# Поэтому entrypoint при отсутствии сертификата разворачивает этот вариант —
# сервис доступен по http, челлендж проходит, — а после успешного выпуска
# перезапуск контейнера подхватывает полный TLS-конфиг.

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    client_max_body_size 1024m;
    keepalive_timeout 3600s;

    gzip on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types application/json application/javascript text/javascript application/xml text/xml text/css text/plain image/svg+xml application/manifest+json;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_http_version 1.1;
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_socket_keepalive on;

    include /etc/nginx/snippets/app-locations.conf;
}
