# Прод-образ фронтенда: собираем статику Vite и отдаём её nginx'ом.
#
# Отличия от dev-образа (./Dockerfile):
#   * сборка на этапе docker build, а не при каждом старте контейнера
#     (dev CMD делает `npm install && npm run build && npm run preview`);
#   * в рантайме остаётся nginx со статикой (~50 МБ) вместо node_modules
#     (сотни МБ) и dev-сервера Vite;
#   * нет bind-mount исходников — образ самодостаточен.

FROM node:20-alpine AS builder

WORKDIR /app

# Слой зависимостей отдельно от исходников: пересобирается только при
# изменении манифестов. `npm ci` вместо `npm install` — ставит строго по
# lock-файлу, без тихого апгрейда версий на проде.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_URL встраивается в бандл на этапе сборки. Обычно оставляем пустым:
# src/config.js возьмёт window.location.origin + '/api', что верно, когда
# фронт и API за одним доменом. Значение можно переопределить в рантайме
# через config.js (см. ниже) — пересборка не нужна.
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build


FROM nginx:1.27-alpine AS runtime

# Статика собранного SPA.
COPY --from=builder /app/dist /usr/share/nginx/html

COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.prod.sh /docker-entrypoint-spa.sh
RUN chmod +x /docker-entrypoint-spa.sh

# Порт 3000, а не 80: upstream frontend_upstream в основном nginx смотрит на
# frontend:3000, как и в деве.
EXPOSE 3000

ENTRYPOINT ["/docker-entrypoint-spa.sh"]
CMD ["nginx", "-g", "daemon off;"]
